# 统一换行与文本处理
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 文本文件
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.parquet binary
*.xlsx binary
*.zip binary
*.mp4 binary

# 生成的图表数据不在 GitHub 语言统计中显示
task2-visual/site/public/data/*.json linguist-generated=true
